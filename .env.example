# Google API Configuration
# Path to Google Service Account JSON file (download from Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json

# Google Drive Configuration
# Root folder ID where all album folders are stored
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_root_folder_id_here

# Google Sheets Configuration
# Spreadsheet ID containing album configuration
GOOGLE_SHEETS_CONFIG_ID=your_sheets_id_here
GOOGLE_SHEETS_CONFIG_RANGE=Sheet1!A:F

# Application Settings
MAX_FILE_SIZE_MB=25
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Session and Cookie Settings
UPLOAD_TIMEOUT_DAYS=7
SESSION_COOKIE_EXPIRY=180
SESSION_COOKIE_SECURE=false

# Application Settings
APP_NAME=PCA Photo Hub
# Set to true to see a diagnostic debug panel on-screen and write detailed
# logs to storage/logs/debug.log (config loading, Google API auth, and
# every Drive/Sheets call). Leave false in production -- no debug output
# of any kind is written or shown when this is false.
APP_DEBUG=false
BASE_URL=http://localhost:8000
# Header logo. Defaults to the Diablo Region lockup; the artwork is black,
# so the header bar it sits on is intentionally white.
LOGO_URL=https://images.squarespace-cdn.com/content/v1/665cd77fbc252a40f650d79a/b5bd754d-1817-4f92-b1ff-0eadd08f98ee/PCA+Diablo+Logo+2+Black+2000px.png?format=1500w

# Timezone
TIMEZONE=America/Los_Angeles

# ============================================================
# Admin & Social Publishing
# ============================================================
# The admin password itself lives in column F ("Admin Password") of the
# config spreadsheet, not here. Widen GOOGLE_SHEETS_CONFIG_RANGE to
# include column F (e.g. Sheet1!A:F) or the admin area stays disabled.

# How long an idle admin session stays logged in.
ADMIN_SESSION_TIMEOUT_MINUTES=60

# Meta fetches photos by URL, so publishing needs to expose each selected
# photo through a signed, short-lived link (public/media.php). Nothing in
# Drive is ever made public. Generate a long random value, e.g.:
#   php -r "echo bin2hex(random_bytes(32));"
MEDIA_LINK_SECRET=
MEDIA_LINK_TTL_MINUTES=15

# Absolute public URL of the public/ directory. Leave blank to derive it
# from the incoming request; set it explicitly if that guesses wrong
# (e.g. https://example.com/pca-photo-hub/public).
PUBLIC_BASE_URL=

# Facebook Page (Groups cannot be posted to -- Meta removed that API in 2024)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# Instagram Business account (must be linked to the Facebook Page above)
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=

META_GRAPH_VERSION=v21.0
