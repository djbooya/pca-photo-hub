# Google API Configuration
# Path to Google Service Account JSON file (download from Google Cloud Console)
GOOGLE_SERVICE_ACCOUNT_JSON=/path/to/service-account.json

# Google Drive Configuration
# Root folder ID where all album folders are stored
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_root_folder_id_here

# Google Sheets Configuration
# Spreadsheet ID containing album configuration
GOOGLE_SHEETS_CONFIG_ID=your_sheets_id_here
GOOGLE_SHEETS_CONFIG_RANGE=Sheet1!A:E

# Application Settings
MAX_FILE_SIZE_MB=25
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Session and Cookie Settings
UPLOAD_TIMEOUT_DAYS=7
SESSION_COOKIE_EXPIRY=180
SESSION_COOKIE_SECURE=false

# Application Settings
APP_NAME=PCA Photo Hub
# Set to true to see a diagnostic debug panel on-screen and write detailed
# logs to storage/logs/debug.log (config loading, Google API auth, and
# every Drive/Sheets call). Leave false in production -- no debug output
# of any kind is written or shown when this is false.
APP_DEBUG=false
BASE_URL=http://localhost:8000

# Timezone
TIMEZONE=America/Los_Angeles
